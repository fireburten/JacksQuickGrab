{
  "name": "jacks-picker",
  "version": "1.0.0",
  "description": "Fast screenshot and annotation tool",
  "author": "Rind Works",
  "main": "main.js",
  "scripts": {
    "build:ocr": "node -e \"process.platform==='darwin'&&require('child_process').execFileSync('bash',['scripts/build-ocr.sh'],{stdio:'inherit'})\"",
    "prestart": "npm run build:ocr",
    "start": "unset ELECTRON_RUN_AS_NODE && electron .",
    "build": "npm run build:ocr && electron-builder",
    "build:dir": "npm run build:ocr && electron-builder --dir",
    "build:mas": "npm run build:ocr && electron-builder --mac mas --universal",
    "build:mas-dev": "npm run build:ocr && electron-builder --mac mas-dev --universal",
    "open:dist": "unset ELECTRON_RUN_AS_NODE && open -n \"$PWD/dist/mac-arm64/Jack's Picker.app\"",
    "rebuild:open": "npm run build:dir && npm run open:dist"
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.rindworks.jackspicker",
    "productName": "Jack's Picker",
    "files": [
      "main.js",
      "preload.cjs",
      "package.json",
      "picker-icon.png",
      "picker-hud.png",
      "bin/**/*",
      "scripts/**/*",
      "!scripts/test-*",
      "src/**/*"
    ],
    "asarUnpack": [
      "bin/**/*",
      "scripts/**/*"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Jack's Picker captures your screen when you take a screenshot or recording.",
        "LSUIElement": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Jack's Picker records your microphone only when you turn on 🎙 for a screen recording."
      },
      "x64ArchFiles": "Contents/Resources/app.asar.unpacked/bin/*"
    },
    "mas": {
      "type": "distribution",
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "provisioningProfile": "build/embedded.provisionprofile"
    },
    "masDev": {
      "type": "development",
      "provisioningProfile": "build/dev.provisionprofile"
    },
    "win": {
      "icon": "picker-icon.png"
    },
    "copyright": "Copyright © 2026 Rind Works"
  }
}
